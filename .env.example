# ── Server (copy to server/.env) ──────────────────────────
# Production host MUST set NODE_ENV=production, a public CLIENT_URL,
# MONGODB_URI, a 32+ character JWT_SECRET, RAZORPAY_WEBHOOK_SECRET (required in production),
# Cloudinary CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET,
# and Razorpay checkout keys. Webhook events: see docs/razorpay.md.

PORT=5000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=parkly
JWT_SECRET=
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Host payouts are manual. Do not enable automatic Razorpay Route transfers.
# See docs/payouts.md.

EMAIL_FROM="Parkly <no-reply@parkly.example>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Client (copy to client/.env) ──────────────────────────
# Local: VITE_API_URL=/api (Vite proxy).
# Production split host: VITE_API_URL=https://api.example.com/api at build time.

VITE_API_URL=/api
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=
