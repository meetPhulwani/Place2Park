# Absolute API origin, including /api.
# Do not commit a filled copy of this file.
# Leave development pointed at your local API unless you intentionally set production.

# Android emulator, API on this computer, default port 5000:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Physical Android phone on the same Wi-Fi. Replace the address with this computer's LAN address:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:5000/api

# Production:
# EXPO_PUBLIC_API_URL=https://api.place2park.me/api

EXPO_PUBLIC_API_URL=

# Public OAuth client IDs. Never put a Google client secret in the app.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID must be the same client ID the API verifies as GOOGLE_CLIENT_ID.
# Android and iOS client IDs identify the installed app. The ID token audience still has to match GOOGLE_CLIENT_ID.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Public Maps key for the Android map. Leave empty to use the list, and Apple Maps on iOS.
# Do not commit a filled key.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
