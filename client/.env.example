# Copy to client/.env. Never commit real secrets.
#
# Local development: keep VITE_API_URL=/api so Vite proxies to Express.
# Production (frontend and API on different hosts): set the public API base
# BEFORE `npm run build` — Vite inlines this value.
#   VITE_API_URL=https://api.place2park.me/api
#
# Browser keys below are public. Restrict them in Google Cloud / Razorpay.
# Never put JWT_SECRET, SMTP_PASS, RAZORPAY_KEY_SECRET, CLOUDINARY_API_SECRET, or Mongo URIs here.

VITE_API_URL=/api
# Optional client request budget in milliseconds. Default 25000. The client does not retry.
# VITE_API_TIMEOUT_MS=25000
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=
# Google Analytics 4 measurement ID for the public site. Example shape: G-XXXXXXXXXX.
# Leave empty to disable. Vite inlines this at build time. The tag loads only in a
# production build of the public website, never in the admin console or local dev.
# It does not receive passwords, emails, phone numbers, bank details, or tokens.
# Browsers that send Global Privacy Control or Do Not Track do not load the tag.
VITE_GA_MEASUREMENT_ID=
