# Copy to client/.env. Never commit real secrets.
#
# Local development: keep VITE_API_URL=/api so Vite proxies to Express.
# Production (frontend and API on different hosts): set the public API base
# BEFORE `npm run build` — Vite inlines this value.
#   VITE_API_URL=https://api.example.com/api
#
# Browser keys below are public. Restrict them in Google Cloud / Razorpay.
# Never put JWT_SECRET, SMTP_PASS, RAZORPAY_KEY_SECRET, or Mongo URIs here.

VITE_API_URL=/api
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=
