# Local Compose defaults. No secrets belong in this file.
# Real values stay in server/.env, which Compose loads after this file when it exists.
# NODE_ENV=development lets the API start against a development database.
# The production image does not include the in-memory MongoDB fallback.
# Put a development Atlas URI in server/.env. Do not point it at production.
# An empty development database is seeded.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8080
MONGODB_DB=parkly
