# Copy to server/.env. Never commit real secrets.
#
# Production host MUST set:
#   NODE_ENV=production
#   CLIENT_URL=https://your-frontend-origin   (exact public SPA origin; not localhost)
#   MONGODB_URI=mongodb+srv://...
#   JWT_SECRET=                               (unique, at least 32 characters)
#   RAZORPAY_WEBHOOK_SECRET=                  (required in production; optional locally)
#   CLOUDINARY_CLOUD_NAME=
#   CLOUDINARY_API_KEY=
#   CLOUDINARY_API_SECRET=
#
# Production Razorpay dashboard must send payment.captured, order.paid,
# payment.failed, refund.processed, and refund.failed to
# https://<api-host>/api/payments/webhook (see docs/razorpay.md).
# Optional on production: Google, SMTP, Razorpay checkout keys (see below).

PORT=5000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=parkly
JWT_SECRET=
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Host payouts are manual (admin approval + bank/UPI reference).
# Do not add Razorpay Route keys or enable automatic transfers.
# See docs/payouts.md.

# Production email: prefer Resend HTTPS (Render often blocks or times out SMTP).
# EMAIL_FROM must be a verified domain sender, e.g. Place2Park <hello@your-domain>.
# onboarding@resend.dev is Resend's sandbox: it only delivers to the Resend account
# address. Signup to any other inbox is rejected (HTTP 403) and the API returns 503.
# Do not use .test / .example / parkly.dev. Placeholder domains disable sending.
# Paste values without surrounding quotes. See docs/DEPLOYMENT_CHECKLIST.md.
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
# Required for production mail on Render. Never commit the key.
RESEND_API_KEY=
# Optional allowlisted inbox for the explicit email probe (defaults to ADMIN_NOTIFICATION_EMAIL).
SMTP_TEST_RECIPIENT=
# Optional SMTP fallback. Ignored when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signup and new Google accounts email a 6-digit code through Resend (RESEND_API_KEY + EMAIL_FROM).

# Bank account numbers are encrypted with this key. Production requires at least
# 32 characters. Generate one with: openssl rand -base64 32
# Do not reuse JWT_SECRET and do not commit the value.
# Ciphertext written before this key existed still decrypts with the legacy key.
# Re-encryption is manual and is not automatic. Back up the database, set this
# key, then have an admin reveal each account and save the same number again.
# Do not do that against production until the backup is confirmed.
PAYOUT_ENCRYPTION_KEY=

# Rate limits are in memory for this API process. A restart clears them, and a
# second instance does not see the first instance's counters. Keep one API
# instance until a shared store exists. Do not set Express trust proxy to true.
# Optional overrides (positive integers). Invalid values keep the defaults below.
# RATE_LIMIT_API=120
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_SIGNUP=5
# RATE_LIMIT_SIGNUP_WINDOW_MS=900000
# RATE_LIMIT_OTP_VERIFY=5
# RATE_LIMIT_OTP_VERIFY_WINDOW_MS=600000
# RATE_LIMIT_GOOGLE=10
# RATE_LIMIT_GOOGLE_WINDOW_MS=900000
# RATE_LIMIT_OTP_VERIFY_IP=20
# RATE_LIMIT_OTP_RESEND=3
# RATE_LIMIT_OTP_RESEND_WINDOW_MS=900000
# RATE_LIMIT_OTP_RESEND_IP=10
# RATE_LIMIT_PASSWORD_RESET=3
# RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
# RATE_LIMIT_BOOKING=10
# RATE_LIMIT_BOOKING_WINDOW_MS=600000
# RATE_LIMIT_BOOKING_CANCEL=10
# RATE_LIMIT_BOOKING_CANCEL_WINDOW_MS=600000
# RATE_LIMIT_PAYMENT_ORDER=10
# RATE_LIMIT_PAYMENT_ORDER_WINDOW_MS=600000
# RATE_LIMIT_PAYMENT_VERIFY=20
# RATE_LIMIT_PAYMENT_VERIFY_WINDOW_MS=600000
# RATE_LIMIT_WEBHOOK=300
# RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
# RATE_LIMIT_REVIEW=10
# RATE_LIMIT_REVIEW_WINDOW_MS=3600000
# RATE_LIMIT_FAVORITE=60
# RATE_LIMIT_FAVORITE_WINDOW_MS=600000
# RATE_LIMIT_REPORT=5
# RATE_LIMIT_REPORT_WINDOW_MS=3600000
# RATE_LIMIT_LISTING_CREATE=10
# RATE_LIMIT_LISTING_CREATE_WINDOW_MS=3600000
# RATE_LIMIT_LISTING_UPDATE=30
# RATE_LIMIT_LISTING_UPDATE_WINDOW_MS=600000
# RATE_LIMIT_PAYOUT_REQUEST=8
# RATE_LIMIT_PAYOUT_REQUEST_WINDOW_MS=600000
# RATE_LIMIT_UPLOAD=30
# RATE_LIMIT_UPLOAD_WINDOW_MS=600000
