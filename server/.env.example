# Copy to server/.env. Never commit real secrets.
#
# Production host MUST set:
#   NODE_ENV=production
#   CLIENT_URL=https://your-frontend-origin   (exact public SPA origin; not localhost)
#   MONGODB_URI=mongodb+srv://...
#   JWT_SECRET=                               (unique, at least 32 characters)
#   RAZORPAY_WEBHOOK_SECRET=                  (required in production; optional locally)
#   CLOUDINARY_CLOUD_NAME=
#   CLOUDINARY_API_KEY=
#   CLOUDINARY_API_SECRET=
#
# Production Razorpay dashboard must send payment.captured, order.paid,
# payment.failed, refund.processed, and refund.failed to
# https://<api-host>/api/payments/webhook (see docs/razorpay.md).
# Optional on production: Google, SMTP, Razorpay checkout keys (see below).

PORT=5000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=parkly
JWT_SECRET=
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Host payouts are manual (admin approval + bank/UPI reference).
# Do not add Razorpay Route keys or enable automatic transfers.
# See docs/payouts.md.

# Production email: prefer Resend HTTPS (Render often blocks or times out SMTP).
# EMAIL_FROM must be a verified Resend sender (or SMTP_USER if SMTP-only).
# Do not use .test / .example / parkly.dev. Placeholder domains disable sending.
# See docs/DEPLOYMENT_CHECKLIST.md.
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
# Required for production mail on Render. Never commit the key.
RESEND_API_KEY=
# Optional allowlisted inbox for the explicit email probe (defaults to ADMIN_NOTIFICATION_EMAIL).
SMTP_TEST_RECIPIENT=
# Optional SMTP fallback. Ignored when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signup OTP. Prefer MSG91 for Indian numbers (DLT-approved template with an OTP variable).
# If neither provider is set, development logs the code on the server only.
# Production refuses to send a code until one provider is configured.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
