# Copy to server/.env. Never commit real secrets.
#
# Production host MUST set:
#   NODE_ENV=production
#   CLIENT_URL=https://your-frontend-origin   (exact public SPA origin; not localhost)
#   MONGODB_URI=mongodb+srv://...
#   JWT_SECRET=                               (unique, at least 32 characters)
#   RAZORPAY_WEBHOOK_SECRET=                  (required in production; optional locally)
#   CLOUDINARY_CLOUD_NAME=
#   CLOUDINARY_API_KEY=
#   CLOUDINARY_API_SECRET=
#
# Optional on production: Google, SMTP, Razorpay checkout keys (see below).

PORT=5000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=parkly
JWT_SECRET=
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EMAIL_FROM="Parkly <no-reply@parkly.example>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
