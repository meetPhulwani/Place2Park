{
  "name": "parkly-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "admin:provision": "tsx src/scripts/admin-account.ts provision",
    "admin:recover": "tsx src/scripts/admin-account.ts recover",
    "admin:lock": "tsx src/scripts/admin-account.ts lock",
    "admin:rotate-totp-keys": "tsx src/scripts/rotate-totp-keys.ts",
    "test": "node ./scripts/run-node-tests.mjs --suite all",
    "test:unit": "node ./scripts/run-node-tests.mjs --suite unit",
    "test:integration": "node ./scripts/run-node-tests.mjs --suite integration",
    "test:coverage": "node ./scripts/run-node-tests.mjs --suite all --coverage",
    "e2e:api": "tsx src/scripts/e2e-bootstrap.ts",
    "indexes:check": "tsx src/scripts/ensure-indexes.ts",
    "payouts:stamp-legacy-keys": "tsx src/scripts/stamp-legacy-payout-keys.ts",
    "test:booking-flow": "tsx src/scripts/test-booking-flow.ts",
    "test:payments": "tsx --test src/services/payments.test.ts && tsx src/scripts/test-payment-flow.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.3.1",
    "parkly": "file:..",
    "razorpay": "^2.9.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^10.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "qs": "6.16.2",
    "follow-redirects": "1.16.2"
  }
}
